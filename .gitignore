# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Scraped data (exclude actual scraped data but allow samples and processed output)
data/*
!data/samples/
!data/samples/service-account-key*.json
!data/.gitkeep
!data/processed/
data/processed/*
!data/processed/.gitkeep
!data/processed/election_results_master.json
!data/processed/wp_inject_state.json
!data/processed/vote_count_state.json

# Renderer outputs — generated on every pipeline run, never commit these
output/election_night/

# Other data formats
*.xml
*.xls
*.xlsx
# Exclude generated/scraped CSVs everywhere except the static election_data roster
*.csv
!election_data/*.csv

# Logs — keep the folder but ignore the actual log files
logs/*
!logs/.gitkeep
*.log
scraper.log
nohup.out

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.claude/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# ChromeDriver
chromedriver
chromedriver.exe

# Temporary files
*.tmp
*.temp

.env
service-account-key*.json
