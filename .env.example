# Election Night Pipeline — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the real values before running anything.
# NEVER commit .env — it is in .gitignore. Only this .env.example gets committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Sheets ────────────────────────────────────────────────────────────
# Path to the Google service account JSON key file on your local machine.
# Download it from Google Cloud Console → IAM → Service Accounts → Keys.
# The service account must be shared as an Editor on the Google Sheet.
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/your/service-account-key.json

# The Google Sheet ID — the long string of letters/numbers in the Sheet's URL:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ── WordPress ────────────────────────────────────────────────────────────────
# The full base URL of the WordPress site (no trailing slash).
WP_SITE_URL=https://your-site.example.com

# WordPress username for the account that will publish the results page.
WP_USERNAME=your_wp_username

# WordPress Application Password for the above account.
# Create one in WP Admin → Users → Profile → Application Passwords.
# It looks like: xxxx xxxx xxxx xxxx xxxx xxxx
WP_APP_PASSWORD=your_wp_application_password

# The WordPress page ID for the election results page.
# Find it in WP Admin → Pages → hover over the page → see ?post=XXXX in the URL.
WP_PAGE_ID=your_wp_page_id
